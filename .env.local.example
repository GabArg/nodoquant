# Variables de entorno — NodoQuant
#
# Copiar este archivo como .env.local y completar los valores necesarios.

# ============================================================
# Supabase
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================================================
# Email
# ============================================================

# Resend API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# Habilita el envío de emails del analyzer.
# En desarrollo puede mantenerse en false.
ENABLE_EMAILS=false

# ============================================================
# Application
# ============================================================

# URL base utilizada para generar enlaces públicos.
# Ejemplo local:
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ejemplo producción:
# NEXT_PUBLIC_APP_URL=https://nodoquant.com

# ============================================================
# Development fallback
# ============================================================

# Si Supabase no está configurado, algunos flujos locales pueden
# guardar datos temporales en archivos como:
#
# leads-dev.json
# analysis-dev.json
#
# Estos archivos están ignorados por Git y no deben utilizarse
# como almacenamiento de producción.